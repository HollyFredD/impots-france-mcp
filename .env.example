# Copier en .env puis remplir. Ne jamais committer .env.
#
# Jeton(s) bearer acceptés, séparés par des virgules.
# Un jeton par device permet de révoquer l'un sans toucher les autres.
# Générer avec : openssl rand -base64 48
MCP_AUTH_TOKENS=

# Hostname(s) public(s) servi(s) par Pangolin, sans port ni schéma.
# La requête est refusée (421) si l'en-tête Host ne correspond pas.
ALLOWED_HOSTNAMES=

# Chemin servi par cette instance. Doit correspondre exactement à l'URL
# annoncée aux clients : https://<hostname><MCP_PATH>.
# Pangolin ne route pas par préfixe, c'est l'application qui restreint la
# surface ; tout autre chemin répond 404.
MCP_PATH=/mcp

# Sonde de santé, également protégée par le jeton.
HEALTH_PATH=/healthz

# Origines navigateur autorisées. Laisser vide pour n'accepter que les
# clients non navigateur (recommandé pour les clients MCP).
ALLOWED_ORIGINS=

# true derrière Pangolin : l'IP client vient de X-Forwarded-For.
TRUST_PROXY=true

LOG_LEVEL=info
MAX_BODY_BYTES=262144
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_TOKEN_PER_MINUTE=600

# --- Topologie B seulement : tunnel Newt ---
# Inutile quand Pangolin tourne sur le même hôte (deploy/vps/compose.yaml).
# URL de l'instance Pangolin qui héberge le site.
PANGOLIN_ENDPOINT=https://pangolin.example.com
# Identifiants du site Newt créé dans Pangolin.
NEWT_ID=
NEWT_SECRET=
NEWT_LOG_LEVEL=INFO
